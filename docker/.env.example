# Copy to docker/.env before running `docker compose up`.

# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me-to-32-random-bytes

# Public URL of this install. Must match how you reach it in the browser —
# it is baked into the client bundle at build time.
APP_URL=http://localhost:3000
APP_PORT=3000

# Optional
POSTGRES_USER=cms
POSTGRES_DB=comlabs_cms
MEDIA_PROVIDER=local
