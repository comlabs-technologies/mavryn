# ---------------------------------------------------------------------------
# Database (required — the CMS does not run without Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://cms:cms@localhost:5432/comlabs_cms?schema=public"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth providers. Leave blank to disable the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Media storage. One of: local | cloudinary | s3
#   local      -> writes to LOCAL_MEDIA_DIR, served from /uploads (dev/self-host)
#   cloudinary -> needs CLOUDINARY_* below
#   s3         -> any S3-compatible store (AWS S3, Cloudflare R2, MinIO)
# ---------------------------------------------------------------------------
MEDIA_PROVIDER="local"
LOCAL_MEDIA_DIR="./.media"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
