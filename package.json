{
  "name": "comlabs-cms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @comlabs/cms-db generate",
    "db:migrate": "pnpm --filter @comlabs/cms-db migrate",
    "db:push": "pnpm --filter @comlabs/cms-db push",
    "db:seed": "pnpm --filter @comlabs/cms-db seed",
    "db:studio": "pnpm --filter @comlabs/cms-db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
